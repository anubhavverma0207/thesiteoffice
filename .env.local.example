# Copy this file to `.env.local` (git-ignored) and fill in the value.
#
# Contact form delivery — Web3Forms (https://web3forms.com):
# 1. Go to web3forms.com, enter the studio inbox address (the email that
#    should RECEIVE enquiries), and they email you an access key.
# 2. Paste the key below and rebuild. Every form submission then arrives
#    in that inbox as an email, with Reply-To set to the visitor.
#
# NEXT_PUBLIC_ because the key ships to the browser; that is how Web3Forms
# works. The key only identifies which inbox to deliver to.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Ask the Crow, live mode (optional).
# Leave empty and the concierge answers instantly from the studio's own
# notes (lib/concierge.ts), zero backend. To upgrade it to a real model,
# deploy a Cloudflare Worker that proxies the Claude API, accepts
# POST { message, history } and returns { reply }, then put its URL here.
NEXT_PUBLIC_CONCIERGE_URL=

# Analytics (all optional; everything no-ops while empty).
# GA4 measurement id (analytics.google.com), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project id (clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=
# Search Console HTML-tag content value; Bing meta content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
