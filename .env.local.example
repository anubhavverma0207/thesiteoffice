# Copy this file to `.env.local` (git-ignored) and fill in the value.
#
# Contact form delivery — Web3Forms (https://web3forms.com):
# 1. Go to web3forms.com, enter the studio inbox address (the email that
#    should RECEIVE enquiries), and they email you an access key.
# 2. Paste the key below and rebuild. Every form submission then arrives
#    in that inbox as an email, with Reply-To set to the visitor.
#
# NEXT_PUBLIC_ because the key ships to the browser — that is how Web3Forms
# works; the key only identifies which inbox to deliver to.
NEXT_PUBLIC_WEB3FORMS_KEY=
